# Copiez ce fichier en « .env » puis remplissez les valeurs.
# Ne partagez jamais le fichier .env (il contient vos secrets).

# Clé API Claude : https://platform.claude.com/ > API Keys
ANTHROPIC_API_KEY=

# Mot de passe de la base PostgreSQL (choisissez-en un long et unique)
POSTGRES_PASSWORD=

# Optionnel
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# APP_PORT=3000
